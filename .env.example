NODE_ENV=production
HOST=127.0.0.1
PORT=26902
DATABASE_PATH=/var/lib/ops-desk/ops.sqlite
COOKIE_SECURE=true
# Set this only if the frontend is hosted on a different trusted origin.
# CORS_ORIGIN=https://ops.example.internal
INITIAL_ADMIN_USERNAME=superadmin
INITIAL_ADMIN_DISPLAY_NAME=System Administrator
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-of-6-plus-characters
# Player service integration. Configure at least the local endpoint for a
# same-server deployment; add the remote endpoint before enabling remote mode.
# Local player token file: mxd-player/backend-player/.env
# Generate a 64-character value with: openssl rand -hex 32
MXD_PLAYER_LOCAL_URL=http://127.0.0.1:26906
# MXD_PLAYER_REMOTE_URL=https://player.example.internal
MXD_PLAYER_SERVICE_TOKEN=replace-with-a-long-random-service-token
MXD_PLAYER_DEPLOYMENT_MODE=local
