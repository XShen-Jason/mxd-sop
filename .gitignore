# Dependencies and build output (recreated by the documented build commands)
node_modules/
.gitnexus/
dist/
build/
coverage/
*.exe
*.test
*.out

# Editor/OS files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Local configuration and persistence. The examples are the only env files
# intended for source control; real values stay on the developer/server host.
.env
.env.*
!.env.example
mxd-player/backend-player/.env
mxd-player/backend-player/.env.*
!mxd-player/backend-player/.env.example
**/auto-credentials.key
*.key
*.pem
*.p12
*.jks
*.db
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Generated catalog/import output
data/item-catalog/generated/
data/generated/
data/player-fbhd
data/char-user-qq/*.csv
data/server_data_check
data/research_data
**/datacj/
*.pcap
*.pcapng
mxd-auto-process/docs/pcap_*.json
**/config/servers.local.json

# Generated embedded frontend assets (the auto build recreates these before
# compiling the Go binary).
mxd-auto-process/backend-auto-process/internal/operatorapi/assets/*
!mxd-auto-process/backend-auto-process/internal/operatorapi/assets/.gitkeep
frontend/.screenshots/
frontend/.chrome-debug/
frontend/.shot-profile/
frontend/.shot-profile-mobile/
frontend/.shot-debug/
frontend/.shot-final/
frontend/.e2e-debug/
frontend/.e2e-debug2/

# Local development artifacts
*-dev.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.backup
