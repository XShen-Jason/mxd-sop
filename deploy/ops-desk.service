[Unit]
Description=Game Support Ops backend
After=network.target

[Service]
Type=simple
User=opsdesk
Group=opsdesk
WorkingDirectory=/opt/ops-desk
EnvironmentFile=/etc/ops-desk/ops-desk.env
ExecStart=/usr/bin/node /opt/ops-desk/backend/dist/src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ops-desk
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
